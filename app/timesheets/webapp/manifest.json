{
  "_version": "1.89.0",
  "sap.app": {
    "id": "psaa.timesheets",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "2414825b-33ec-46e0-a151-94953938ef86"
    },
    "dataSources": {
      "mainService": {
        "uri": "/psa/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "psaa.timesheets.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TimesheetSrvList",
          "target": "TimesheetSrvList"
        },
        {
          "pattern": "TimesheetSrv({key}):?query:",
          "name": "TimesheetSrvObjectPage",
          "target": "TimesheetSrvObjectPage"
        }
      ],
      "targets": {
        "TimesheetSrvList": {
          "type": "Component",
          "id": "TimesheetSrvList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/TimesheetSrv",
              "variantManagement": "Page",
              "navigation": {
                "TimesheetSrv": {
                  "detail": {
                    "route": "TimesheetSrvObjectPage"
                  }
                }
              },
              
"controlConfiguration": {
  "@com.sap.vocabularies.UI.v1.LineItem": {
    "tableSettings": {
      "type": "ResponsiveTable"
    },
    "creationMode": {
      "name": "Inline"
    }
  }
}

            }
          }
        },
        
"TimesheetSrvObjectPage": {
  "type": "Component",
  "id": "TimesheetSrvObjectPage",
  "name": "sap.fe.templates.ObjectPage",
  "options": {
    "settings": {
      "editableHeaderContent": false,
      "contextPath": "/TimesheetSrv",
      "content": {
        "header": {
          "actions": {
            "SubmitTimesheet": {
              "text": "Submit Timesheet",
              "press": "psaa.timesheets.ext.controller.TimesheetActions.onSubmitTimesheet",
              "visible": true
            }
          }
        }
      }
    }
  }
}
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
